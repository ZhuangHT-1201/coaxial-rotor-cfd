FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type totalPressure;
        p0 uniform 0;
        value uniform 0;
    }
    outlet
    {
        type totalPressure;
        p0 uniform 0;
        value uniform 0;
    }
    farfield
    {
        type totalPressure;
        p0 uniform 0;
        value uniform 0;
    }
    lower_rotor
    {
        type zeroGradient;
    }
    upper_rotor
    {
        type zeroGradient;
    }
}

